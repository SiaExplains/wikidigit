# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Canonical site URL (defaults to https://www.wikidigit.com)
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional; GA only loads
# after a reader accepts analytics in the cookie banner.
NEXT_PUBLIC_GA_ID=

# Email (Resend). The newsletter and contact forms only appear when
# RESEND_API_KEY, RESEND_SEGMENT_ID and NEWSLETTER_TOKEN_SECRET are all set.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Optional: a topic subscribers are opted into, for per-topic unsubscribe
RESEND_TOPIC_ID=
# Random secret for signing confirmation links: openssl rand -base64 32
NEWSLETTER_TOKEN_SECRET=
EMAIL_FROM="WikiDigit <hi@wikidigit.com>"
CONTACT_TO=siaexplains@gmail.com
